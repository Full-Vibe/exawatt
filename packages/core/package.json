{
  "name": "@exawatt/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist-cjs/index.js",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "require": "./dist-cjs/server.js",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:run": "vitest run",
    "type-check": "tsc --noEmit",
    "types:build": "tsc -p tsconfig.types.json && tsc -p tsconfig.runtime.json && node scripts/write-runtime-package.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@noble/ed25519": "^3.0.1"
  }
}
