{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "root-public-toolchain",
      "classification": "PUBLIC",
      "include": [
        ".gitignore",
        ".impeccable.md",
        ".npmrc",
        ".prettierrc",
        "ASSET_PROVENANCE.json",
        "LICENSE",
        "LICENSING.md",
        "PROJECT.md",
        "THIRD_PARTY_NOTICES.md",
        "components.json",
        "eslint.config.mjs",
        "instrumentation-client.ts",
        "next.config.ts",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "postcss.config.mjs",
        "tsconfig.json",
        "vitest.config.app-dom.ts",
        "vitest.config.app-node.ts",
        "vitest.config.ts",
        "vitest.setup.ts"
      ],
      "exclude": []
    },
    {
      "id": "community-health-public",
      "classification": "PUBLIC",
      "include": [
        ".github/CODEOWNERS",
        ".github/ISSUE_TEMPLATE/bug_report.yml",
        ".github/ISSUE_TEMPLATE/config.yml",
        ".github/ISSUE_TEMPLATE/roadmap_proposal.yml",
        ".github/PULL_REQUEST_TEMPLATE.md",
