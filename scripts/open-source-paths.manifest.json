        "CONTRIBUTING.md",
        "GOVERNANCE.md",
        "SECURITY.md",
        "SUPPORT.md",
        "TRADEMARKS.md"
      ],
      "exclude": []
    },
    {
      "id": "public-repository-security-automation",
      "classification": "PUBLIC",
      "include": [
        ".github/dependabot.yml",
        ".github/workflows/codeql.yml",
        ".github/workflows/dependency-review.yml",
        ".github/workflows/gitleaks.yml"
      ],
      "exclude": []
    },
    {
      "id": "repository-agent-public",
      "classification": "PUBLIC",
      "include": [
        ".codex/**"
      ],
      "exclude": []
    },
    {
      "id": "public-source-spine",
      "classification": "PUBLIC",
      "include": [
        "contracts/**",
        "packages/**",
        "patches/**",
        "themes/**"
      ],
      "exclude": []
    },
    {
      "id": "public-license-texts",
      "classification": "PUBLIC",
      "include": [
        "LICENSES/**"
      ],
      "exclude": []
    },
    {
      "id": "public-documentation",
      "classification": "PUBLIC",
      "include": [
        "docs/archive/**",
        "docs/engineering/**",
        "docs/product/**",
        "docs/references/**"
      ],
      "exclude": []
    },
    {
      "id": "electron-public",
      "classification": "PUBLIC",
      "include": [
        "electron/**"
      ],
      "exclude": []
    },
    {
      "id": "public-assets",
      "classification": "PUBLIC",
      "include": [
        "public/**"
      ],
      "exclude": []
