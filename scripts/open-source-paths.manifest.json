    {
      "id": "public-script-evaluations",
      "classification": "PUBLIC",
      "include": [
        "scripts/*-eval.mjs"
      ],
      "exclude": []
    },
    {
      "id": "public-script-tests",
      "classification": "PUBLIC",
      "include": [
        "scripts/*.test.mjs"
      ],
      "exclude": []
    },
    {
      "id": "public-script-libraries",
      "classification": "PUBLIC",
      "include": [
        "scripts/lib/**"
      ],
      "exclude": []
    },
    {
