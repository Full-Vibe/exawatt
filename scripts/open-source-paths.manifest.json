        "scripts/terminal-cost-probe.mjs",
        "scripts/transcript-replay-probe.mjs",
        "scripts/worktree-setup.mjs"
      ],
      "exclude": []
    },
    {
      "id": "application-public",
      "classification": "PUBLIC",
      "include": [
        "src/**"
      ],
      "exclude": []
    }
