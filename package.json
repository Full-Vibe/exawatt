{
  "name": "exawatt",
  "version": "0.1.10",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Full-Vibe/exawatt.git"
  },
  "packageManager": "pnpm@10.30.1",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "agent:land": "node scripts/agent-land.mjs",
    "assets:check": "node scripts/check-asset-provenance.mjs",
    "test:asset-provenance": "node --test scripts/check-asset-provenance.test.mjs",
    "content:scan": "node scripts/public-content-scan.mjs",
    "company:compose": "node scripts/company-compose.mjs",
    "company:proof": "node scripts/company-proof.mjs",
    "test:contracts": "vitest run --config contracts/conformance/vitest.config.ts --maxWorkers=25%",
    "open-source:paths:check": "node scripts/open-source-paths.mjs check",
    "open-source:paths:plan": "node scripts/open-source-paths.mjs plan",
    "open-source:paths:project": "node scripts/open-source-paths.mjs project",
    "open-source:reseed": "node scripts/open-source-reseed.mjs",
    "contribution:pull": "node scripts/contribution-pull.mjs",
    "security:audit:prod": "node scripts/production-dependency-audit.mjs",
    "community:check": "node --test scripts/community-policy.test.mjs",
    "licenses:generate": "node scripts/check-dependency-licenses.mjs --write",
    "licenses:check": "node scripts/check-dependency-licenses.mjs",
    "publication:check": "node scripts/publication-check.mjs",
    "test:publication": "node --test scripts/github-workflows.test.mjs scripts/publication-check.test.mjs scripts/check-asset-provenance.test.mjs scripts/check-dependency-licenses.test.mjs",
    "test:workflows": "node --test scripts/github-workflows.test.mjs scripts/publication-check.test.mjs",
    "agent-sources:generate": "node scripts/generate-agent-source-declarations.mjs",
    "agent-sources:check": "pnpm agent-sources:generate && git diff --exit-code -- src/generated/agent-source-declarations.ts electron/main/pty/generated-agent-source-declarations.ts",
    "icon:generate": "node scripts/generate-app-icon.mjs",
    "icon:check": "node scripts/generate-app-icon.mjs --check",
    "theme:generate": "node scripts/generate-themes.mjs",
    "theme:check": "node scripts/generate-themes.mjs --check && node scripts/check-production-theme-literals.mjs",
    "test:theme-literals": "node --test scripts/check-production-theme-literals.test.mjs",
    "test:fonts": "node --test scripts/font-self-hosting.test.mjs",
    "distribution:prepare": "pnpm --filter @exawatt/core types:build && node scripts/prepare-distribution.mjs",
    "test:distribution": "pnpm --filter @exawatt/core types:build && vitest run packages/core/src/distribution/contract.test.ts src/lib/distribution/community-neutrality.test.ts src/lib/distribution/community-closure.test.ts electron/main/distribution.test.ts --maxWorkers=25% && node --test scripts/distribution-build.test.mjs",
    "test:enrichment-distribution": "pnpm --filter @exawatt/core types:build && vitest run electron/main/pty/enrichment-distribution.test.ts electron/main/pty/context-summarizer.test.ts electron/main/pty/conversation-catalog.test.ts src/app/hud-gallery/goal-visuals/page.test.tsx src/components/workspace/recent-conversations.test.tsx --maxWorkers=25%",
    "dev": "pnpm distribution:prepare && node scripts/run-next-with-distribution.mjs dev -p 7000",
    "build": "pnpm distribution:prepare && node scripts/run-next-with-distribution.mjs build",
    "verify:community-build": "env -u EXAWATT_DISTRIBUTION_CONFIG_JSON -u EXAWATT_DISTRIBUTION_PROFILE pnpm run build",
    "verify:community-runtime": "env -u EXAWATT_DISTRIBUTION_CONFIG_JSON vitest run src/lib/distribution/community-runtime.test.ts src/lib/distribution/community-neutrality.test.ts src/lib/distribution/community-closure.test.ts src/lib/shortcuts/preference-source.dom.test.ts --maxWorkers=25%",
    "start": "node scripts/run-next-with-distribution.mjs start",
    "lint": "eslint",
    "type-check": "pnpm distribution:prepare && node scripts/run-next-with-distribution.mjs typegen && tsc --noEmit",
    "test": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest",
    "test:ui": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest --ui",
    "test:run": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest run --maxWorkers=25%",
    "test:ci": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest run --maxWorkers=2",
    "test:changed": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest run --changed=origin/master --maxWorkers=25% --passWithNoTests",
    "test:related": "NODE_COMPILE_CACHE=node_modules/.cache/node-compile-cache vitest related --run --maxWorkers=25% --passWithNoTests",
    "test:coverage": "vitest --coverage",
    "test:agent-delivery": "node --test scripts/install-freshness.test.mjs scripts/agent-land.test.mjs scripts/ci-batch.test.mjs scripts/delivery-documentation.test.mjs scripts/delivery-policy.test.mjs scripts/delivery-queue.test.mjs scripts/dogfood-queue.test.mjs scripts/agent-stop-check.test.mjs scripts/dogfood-delivery.test.mjs scripts/dogfood-install-identity.test.mjs scripts/macos-code-signing.test.mjs scripts/app-icon.test.mjs scripts/app-update-config.test.mjs scripts/electron-eval.test.mjs scripts/packed-app-assertions.test.mjs scripts/qa-browser.test.mjs scripts/worktree-env.test.mjs scripts/worktree-setup.test.mjs scripts/feedback-lanes.test.mjs scripts/public-content-scan.test.mjs scripts/open-source-paths.test.mjs scripts/public-projection.test.mjs scripts/public-delivery.test.mjs scripts/contribution-pull.test.mjs scripts/recipe-renderers.test.mjs scripts/production-dependency-audit.test.mjs scripts/check-dependency-licenses.test.mjs scripts/script-layout.test.mjs scripts/suite-environment.test.mjs scripts/github-workflows.test.mjs scripts/publication-check.test.mjs scripts/font-self-hosting.test.mjs scripts/distribution-build.test.mjs scripts/packaged-app.test.mjs scripts/company-overlay.test.mjs scripts/company-route-boundary.test.mjs",
    "test:worktree-setup": "node --test scripts/worktree-env.test.mjs scripts/worktree-setup.test.mjs",
    "test:scripts-layout": "node --test scripts/script-layout.test.mjs",
    "qa:browser:doctor": "node scripts/qa-browser-doctor.mjs",
    "qa:browser:smoke": "node scripts/qa-browser-smoke.mjs",
    "eval:consumption-scan": "node --expose-gc scripts/consumption-scan-eval.mjs",
    "eval:r3f": "node scripts/r3f-eval/run.mjs",
    "eval:hero-board": "node scripts/hero-board-idle-eval.mjs",
    "eval:theme-system": "node scripts/theme-system-eval.mjs",
    "eval:navigation-paint": "node scripts/navigation-paint-eval.mjs",
    "eval:typography-stability": "node scripts/typography-stability-eval.mjs",
    "eval:goal-visuals-stability": "node scripts/goal-visuals-stability-eval.mjs",
    "eval:spatial": "node scripts/r3f-eval/spatial.mjs",
    "eval:spatial:pointer": "node scripts/spatial-pointer-eval.mjs",
    "eval:spatial:scale": "node scripts/spatial-scale-eval.mjs",
    "eval:spatial:motion": "node scripts/spatial-motion-eval.mjs",
    "eval:navigation": "node scripts/command-altitude-eval.mjs",
    "eval:navigation:electron": "node scripts/electron-navigation-eval.mjs",
    "eval:navigation:spine": "node scripts/electron-spine-eval.mjs",
    "eval:navigation:native": "node scripts/electron-native-navigation-eval.mjs",
    "eval:community:network": "env -u EXAWATT_DISTRIBUTION_CONFIG_JSON -u EXAWATT_DISTRIBUTION_PROFILE node scripts/community-network-observatory.mjs",
    "eval:electron:packaged": "node scripts/electron-packaged-smoke.mjs",
    "eval:electron:code-identity": "node scripts/electron-code-identity-eval.mjs",
    "eval:electron:update": "node scripts/electron-product-update-eval.mjs",
    "eval:electron:resume": "node scripts/electron-exact-resume-eval.mjs",
    "eval:electron:idempotency": "node scripts/electron-rehydration-idempotency-eval.mjs",
    "eval:electron:lifecycle": "node scripts/electron-session-lifecycle-eval.mjs",
    "eval:electron:real-harness": "node scripts/electron-real-harness-eval.mjs",
    "eval:electron:terminal": "node scripts/electron-terminal-fundamentals-eval.mjs",
    "eval:electron:chrome": "node scripts/electron-chrome-eval.mjs",
    "eval:workspace:chrome": "node scripts/workspace-chrome-layout-eval.mjs",
    "eval:workspace:ribbon": "node scripts/project-ribbon-motion-eval.mjs",
    "eval:workspace:ribbon:bench": "node scripts/ribbon-dogfood-bench-eval.mjs",
    "eval:workspace:launcher": "node scripts/agent-launcher-bench-shot.mjs",
    "eval:workspace:team": "node scripts/team-order-eval.mjs",
    "eval:workspace:paused": "node scripts/paused-agent-record-eval.mjs",
    "eval:workspace:split": "node scripts/workspace-split-eval.mjs",
    "eval:workspace:draft": "node scripts/workspace-draft-paste-eval.mjs",
    "eval:electron:project-agent": "node scripts/electron-project-agent-launcher-eval.mjs",
    "eval:electron:agent-sources": "node scripts/electron-agent-sources-eval.mjs",
    "eval:electron:grok-source": "node scripts/electron-grok-source-eval.mjs",
    "eval:electron:recents": "node scripts/electron-recent-conversations-eval.mjs",
    "eval:electron:startup": "node scripts/electron-startup-eval.mjs",
    "eval:electron:appearance": "node scripts/electron-appearance-eval.mjs",
    "eval:electron:offline": "node scripts/electron-offline-eval.mjs",
    "eval:electron:session-parity": "node scripts/electron-session-spatial-parity-eval.mjs",
    "eval:electron:interaction-performance": "node scripts/electron-interaction-performance-eval.mjs",
    "eval:context-labels": "vitest run src/lib/context-labels/contract.test.ts src/lib/context-labels/gold-evaluator.test.ts electron/main/pty/context-summarizer.test.ts src/app/api/context-labels/route.test.ts --maxWorkers=25%",
    "eval:context-labels:gold": "node scripts/context-label-gold-eval.mjs",
    "eval:electron:context-labels": "node scripts/electron-context-label-feedback-eval.mjs",
    "electron:compile": "pnpm --filter @exawatt/core types:build && tsc -p electron/tsconfig.json && node scripts/discard-electron-snapshot.mjs",
    "electron:dev": "pnpm distribution:prepare && pnpm electron:compile && node scripts/electron-dev.mjs",
    "electron:prepare-renderer": "node scripts/prepare-electron-renderer.mjs",
    "electron:prepare-main": "node scripts/prepare-electron-main.mjs",
    "electron:prepare-licenses": "node node_modules/electron/install.js",
    "electron:prepare-main:package": "node scripts/prepare-electron-main.mjs --package",
    "electron:prepare-builder": "node scripts/prepare-electron-builder-config.mjs",
    "electron:prepare-builder:dogfood": "node scripts/prepare-electron-builder-config.mjs --dogfood",
    "electron:build": "EXAWATT_COMPOSITION_PROFILE=official-desktop pnpm build && pnpm electron:prepare-renderer && pnpm electron:compile && electron-builder install-app-deps && pnpm electron:prepare-main:package && pnpm electron:prepare-licenses && pnpm electron:prepare-builder && electron-builder --mac --config .exawatt-build/electron-builder.base.json --config.npmRebuild=false --config.mac.identity=null --config.mac.notarize=false",
    "electron:build:dir": "EXAWATT_COMPOSITION_PROFILE=official-desktop pnpm build && pnpm electron:prepare-renderer && pnpm electron:compile && electron-builder install-app-deps && pnpm electron:prepare-main:package && pnpm electron:prepare-licenses && pnpm electron:prepare-builder && electron-builder --mac dir --arm64 --config .exawatt-build/electron-builder.base.json --config.npmRebuild=false --config.mac.identity=null --config.mac.notarize=false",
    "electron:build:dogfood": "node scripts/build-dogfood.mjs",
    "electron:install-dogfood": "EXAWATT_REQUIRE_OFFICIAL_DOGFOOD=1 EXAWATT_DOGFOOD_ALLOWED_PREVIOUS_IDENTIFIER=com.exawatt.app node --env-file-if-exists=.env.local scripts/install-dogfood.mjs",
    "electron:rebuild": "electron-rebuild -f -w node-pty",
    "env:pull": "vercel env pull .env.local --environment=development --yes",
    "worktree:setup": "node scripts/worktree-setup.mjs",
    "eval:electron:delegation": "node scripts/electron-delegation-eval.mjs",
    "eval:electron:turn-truth": "node scripts/electron-turn-truth-eval.mjs",
    "eval:electron:tenancy": "node scripts/electron-workspace-tenancy-eval.mjs",
    "eval:electron:operator-stats": "node scripts/electron-operator-stats-eval.mjs",
    "eval:roadmap:rail": "node scripts/roadmap-rail-eval.mjs",
    "electron:build:dogfood:official": "EXAWATT_DISTRIBUTION_PROFILE=official node scripts/build-dogfood.mjs"
  },
