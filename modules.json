    {
      "id": "delivery",
      "summary": "The delivery system: agent:land, the queue, landing checks, CI batching, dogfood and release tooling. Its suite is test:agent-delivery.",
      "environment": "node",
      "paths": ["scripts/", ".githooks/"],
      "entrypoints": [
        "scripts/lib/distribution-build.mjs",
        "scripts/lib/hermetic-git.mjs",
        "scripts/lib/open-source-paths.mjs"
      ],
      "dependsOn": ["core"],
      "scripts": ["test:agent-delivery"]
    }
  ],
  "integrationTests": [
    {
      "test": "src/components/workspace/session-custody.dom.test.ts",
      "modules": ["workspace", "pty"],
      "why": "drives the workspace against the real Session owner behind an IPC double no more capable than ipcRenderer"
    },
    {
      "test": "electron/main/harness-events/harness-event-log.test.ts",
      "modules": ["harness-events", "pty"],
      "why": "relaunches the real Session owner over one profile and reads its starts, exits and harness events back from the log"
    },
    {
      "test": "src/components/workspace/turn-truth-pipeline.test.ts",
      "modules": ["workspace", "pty", "harness-events"],
      "why": "runs the turn-truth wiring main ships against the renderer status words it produces"
    },
    {
      "test": "src/components/workspace/launch-verdict-parity.test.ts",
      "modules": ["workspace", "pty"],
      "why": "holds the renderer launch verdict to the Agent Source registry main decides with"
    },
    {
      "test": "electron/main/harness-events/codex-app-server.test.ts",
      "modules": ["harness-events", "workspace", "ui-model", "core"],
      "why": "drives the Codex adapter through the local Session transport and the status words Team and Fleet show"
    },
    {
      "test": "electron/main/harness-events/codex-real-shapes.test.ts",
      "modules": ["harness-events", "workspace", "pty"],
      "why": "replays captured Codex event shapes through attention and the renderer status words"
    },
    {
      "test": "electron/main/pty/session-agent-name.test.ts",
      "modules": ["pty", "bus"],
      "why": "holds a Session's Agent name to the bus directory that addresses it"
    },
    {
      "test": "electron/main/consumption/scanner-service.test.ts",
      "modules": ["consumption", "core"],
      "why": "scans the consumption fixtures core's own parser tests use"
    }
  ]
}
