        "src/components/fleet/spatial/spatial-selection-panel.tsx",
        "src/components/fleet/spatial/spatial-theme.ts"
      ],
      "dependsOn": ["core", "ui-model", "workspace"]
    },
    {
      "id": "website",
      "summary": "The public website: the homepage fleet story, hero board, changelog and download surfaces.",
      "environment": "dom",
      "paths": ["src/components/site/"],
      "entrypoints": [
        "src/components/site/download.ts",
        "src/components/site/changelog/changelog-entry.tsx",
        "src/components/site/docs/doc-blocks.tsx",
        "src/components/site/docs/site-doc-page.tsx",
        "src/components/site/fleet-story/fleet-model.ts",
        "src/components/site/fleet-story/footer-gesture.tsx",
        "src/components/site/fleet-story/homepage-settings.ts",
        "src/components/site/fleet-story/names.ts",
        "src/components/site/fleet-story/pinned-agent-panel.tsx",
        "src/components/site/fleet-story/scroll-experience.tsx",
        "src/components/site/fleet-story/sphere.ts",
        "src/components/site/fleet-story/stages.ts",
        "src/components/site/fleet-story/visual-canvas.tsx",
